# Copy to .env (gitignored) and fill from the operator vault.

# Interface to publish ports on. 127.0.0.1 = same-host gateway only; a LAN IP = gateway on another on-prem machine.
BIND_ADDR=127.0.0.1

MSSQL_IMAGE_TAG=2022-latest
MSSQL_SA_PASSWORD=
# Read-only SQL login used by the SUT (through its on-prem gateway).
SUT_READER_PASSWORD=

# Pin to a specific version for repeatable builds.
SPLUNK_IMAGE_TAG=latest
SPLUNK_PASSWORD=
# GUID, e.g. generated with: [guid]::NewGuid()
SPLUNK_HEC_TOKEN=

# Only needed with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
