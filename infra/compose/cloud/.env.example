# Copy to .env (gitignored). Secrets are synced from the vault with scripts/env/secret-env.mjs (SETUP.md).

CLOUDFLARED_IMAGE_TAG=latest
# Connector token of the remotely managed tunnel "cloud" (Cloudflare Zero Trust -> Networks -> Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# --- authentik (Phase 6b) ---
AUTHENTIK_IMAGE_TAG=2025.10
AUTHENTIK_POSTGRES_IMAGE_TAG=16-alpine
AUTHENTIK_SECRET_KEY=
AUTHENTIK_PG_PASS=
# akadmin's email and password, and an API token for automation; used only on the first start.
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# --- Log shipping to Splunk (Phase 8). Uncomment the two COMPOSE_* lines to enable the logging override. ---
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=docker-compose.yml,docker-compose.logging.yml
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# --- Odoo (Phase 7a) ---
ODOO_IMAGE_TAG=19.0
ODOO_POSTGRES_IMAGE_TAG=16-alpine
ODOO_DB_PASSWORD=
# Odoo's master (database manager) password; the manager UI is disabled, but the value must still be strong.
ODOO_MASTER_PASSWORD=
