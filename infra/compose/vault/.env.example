# Copy to .env (gitignored). Before the vault exists, keep these values in your personal password manager.

# Permanent URL. Never change after users are enrolled.
APP_FULL_BASE_URL=https://vault.example.com

PASSBOLT_IMAGE_TAG=latest-ce
MARIADB_IMAGE_TAG=10.11
PASSBOLT_DB_PASSWORD=

# 127.0.0.1 = operator machine only. Change HTTPS_PORT only if 443 is taken (then include the port in APP_FULL_BASE_URL).
BIND_ADDR=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443

# SMTP (SETUP.md Phase 4, via M365 ops@<domain>). Leave host empty until then.
EMAIL_DEFAULT_FROM=
EMAIL_TRANSPORT_DEFAULT_HOST=
EMAIL_TRANSPORT_DEFAULT_PORT=587
EMAIL_TRANSPORT_DEFAULT_USERNAME=
EMAIL_TRANSPORT_DEFAULT_PASSWORD=
EMAIL_TRANSPORT_DEFAULT_TLS=true
